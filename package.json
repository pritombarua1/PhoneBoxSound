{
  "name": "phoneboxsound",
  "version": "3.1.0",
  "description": "Turn phones into synchronised wireless speakers, a media remote and an intercom for your Windows PC.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p web --noEmit && vite build",
    "start": "npm run build && python -m phoneboxsound",
    "serve": "python -m phoneboxsound",
    "typecheck": "tsc -p web --noEmit",
    "test": "python -m pytest tests -q",
    "docs": "node scripts/docs.mjs",
    "docs:videos": "node scripts/tour.mjs",
    "setup": "python -m pip install --user -r requirements.txt",
    "package": "npm run build && python scripts/package.py",
    "package:extension": "python scripts/extension.py",
    "check:real": "node scripts/realcheck.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
